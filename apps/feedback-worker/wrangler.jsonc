{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ficelle-feedback",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ficelle-feedback",
      // the id `wrangler d1 create ficelle-feedback` prints
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "ficelle-feedback-images" }],
  "vars": {
    // zero bits a report's proof of work needs, more for busy senders
    "POW_BITS": "18",
  },
  // reports past their keeping time, old sends and challenges
  "triggers": { "crons": ["17 3 * * *"] },
}
