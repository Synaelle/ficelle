{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["vite/client"],
    // the stand-in has the core's types, see vite.config.ts
    "paths": { "@app/core-web": ["./src/lib/backend/noCore.ts"] }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte"]
}
