<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen widget: new note and search, then up to four recent notes.
     The Simple theme's colours, the default. Filled by NotesWidget.kt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:text="@string/app_name"
            android:textColor="#EDE7E1"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/widget_search"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/widget_button"
            android:contentDescription="@string/shortcut_search"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_shortcut_search" />

        <ImageButton
            android:id="@+id/widget_new_note"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_button"
            android:contentDescription="@string/shortcut_new_note"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_shortcut_new_note" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingTop="8dp"
        android:text="@string/widget_open_once"
        android:textColor="#9C948D"
        android:textSize="14sp" />

    <TextView android:id="@+id/widget_note_0" style="@style/WidgetNote" />
    <TextView android:id="@+id/widget_note_1" style="@style/WidgetNote" />
    <TextView android:id="@+id/widget_note_2" style="@style/WidgetNote" />
    <TextView android:id="@+id/widget_note_3" style="@style/WidgetNote" />
</LinearLayout>
