# Template of the AUR package ficelle-bin, filled for each stable release by
# tools/aur/update.mjs (@VERSION@ and @SHA256@). It takes the release's
# archive of the program, its launcher and icons, and uses the system's
# WebKitGTK.
pkgname=ficelle-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc='A lightweight, private notes app for your computer and your phone'
arch=('x86_64')
url='https://ficelle.synaelle.com'
license=('AGPL-3.0-or-later')
depends=('webkit2gtk-4.1' 'gtk3' 'libsoup3' 'glib2' 'cairo' 'gdk-pixbuf2' 'hicolor-icon-theme')
provides=('ficelle')
conflicts=('ficelle')
options=('!strip' '!debug')
source=("Ficelle_${pkgver}_amd64.tar.zst::https://github.com/Synaelle/ficelle/releases/download/v${pkgver}/Ficelle_${pkgver}_amd64.tar.zst")
sha256sums=('@SHA256@')

package() {
  cd usr
  install -Dm755 bin/ficelle "$pkgdir/usr/bin/ficelle"
  install -Dm644 share/applications/Ficelle.desktop "$pkgdir/usr/share/applications/Ficelle.desktop"
  # one by one: the archive keeps the AppImage's private folders (700)
  find share/icons -type f -exec install -Dm644 {} "$pkgdir/usr/{}" \;
}
