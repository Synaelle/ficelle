  <id>com.synaelle.ficelle</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>
  <name>Ficelle</name>
  <summary>Lightweight notes in Markdown</summary>
  <developer id="com.synaelle">
    <name>Synaelle</name>
  </developer>
  <description>
    <p>Ficelle is a small notes app that opens in a moment and uses little memory. Notes are Markdown, with checklists, tables, callouts and images you place like in a word processor. Every note keeps its earlier versions.</p>
    <p>Your notes stay on your own devices. Your computer and your phone sync directly on the same network, with no account and no server. Notes can be encrypted with a password, and backups go to a folder you choose.</p>
  </description>
  <launchable type="desktop-id">com.synaelle.ficelle.desktop</launchable>
