# Copy to .env next to compose.yml and fill in.

# Where people reach this instance, as the reverse proxy serves it. Under a
# path of a site you have already, write it with the path,
# https://example.org/notes: everything is then served under /notes (see
# deploy/nginx/subpath.conf).
PUBLIC_URL=https://notes.example.org

# The port on 127.0.0.1 the proxy forwards to.
PORT=8080

# true to take feedback reports from anyone's apps (leave false unless you
# run the instance the apps send their reports to).
FEEDBACK_RECEIVE=false

# Who runs this instance and how to reach them about personal data, shown
# on its privacy page ("Who runs this server"). A person, an association
# or a company, and an email or an address.
PRIVACY_OPERATOR=
PRIVACY_CONTACT=
