# Copy to .env next to compose.yml and fill in.

# The name people use, its DNS already pointing at this machine.
DOMAIN=notes.example.org

# Empty for the whole name. A path like /notes serves Ficelle under it
# only, https://notes.example.org/notes, other paths left to other services.
BASE_PATH=

# Let's Encrypt writes here when a certificate is about to run out.
ACME_EMAIL=you@example.org
